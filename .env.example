# PayPal sandbox credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# W2 server-only OpenAI-compatible structured-output service
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# W3 shared payment limit (configuration, not a credential)
MAX_TRANSACTION_USD=200
# APP_URL defaults to http://localhost:4321 in wrangler.jsonc.
