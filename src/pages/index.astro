---
import Layout from '../components/Layout.astro';
import { runtime } from '../lib/runtime';
import { applicationError } from '../lib/errors';
let ready = false;
let configurationError = '';
let configuredOrigin = 'http://localhost:4321';
try {
  const { config } = runtime();
  ready = !!(config.clientId && config.clientSecret);
  configuredOrigin = config.appUrl;
} catch (error) {
  const failure = applicationError(error);
  configurationError = `${failure.stage} · ${failure.code}: ${failure.message}`;
}
const originMatches = configuredOrigin === Astro.url.origin;
---
<Layout title="Manual sandbox order">
  <p class="eyebrow">W1 · payment service verification</p>
  <h1>Create a sandbox order</h1>
  <p>Review these fields before submitting. This button creates a PayPal sandbox order; buyer approval happens on PayPal next.</p>
  {configurationError && <p class="error" role="alert">{configurationError}</p>}
  {!ready && <p class="notice" role="status"><strong>Credentials not configured.</strong> Fill <code>PAYPAL_CLIENT_ID</code> and <code>PAYPAL_CLIENT_SECRET</code> locally in this checkout’s <code>.env</code>. Do not send values through chat.</p>}
  {!originMatches && <p class="error" role="alert">Open this app at <a href={configuredOrigin}>{configuredOrigin}</a>. APP_URL must match the origin used for create, return, and cancel.</p>}
  <section aria-labelledby="form-heading">
    <h2 id="form-heading">Manual payment details</h2>
    <form method="POST" action="/orders/create">
      <label for="payee">Actual sandbox payee email</label>
      <input id="payee" type="email" name="payeeEmail" required maxlength="254" autocomplete="off" placeholder="Use the sandbox merchant account email" />
      <div class="row">
        <div><label for="amount">Amount</label><input id="amount" type="number" name="amount" value="10.00" min="0.01" step="0.01" required /></div>
        <div><label for="currency">Currency</label><input id="currency" name="currency" value="USD" readonly /></div>
      </div>
      <label for="description">Purpose / description</label>
      <input id="description" name="description" value="SayPay W1 sandbox test" required maxlength="127" />
      <p class="hint">Use an English description for this W1 test. The server enforces 127 UTF-8 bytes so PayPal returns the description without truncation.</p>
      <button type="submit" disabled={!ready || !originMatches}>Create sandbox order and open PayPal</button>
    </form>
  </section>
  <section aria-labelledby="lookup-heading">
    <h2 id="lookup-heading">Read an existing order</h2>
    <p>Use the PayPal order token from the checkout or return URL if checkout loops. No local order database is needed.</p>
    <form method="GET" action="/status">
      <label for="token">PayPal order token</label><input id="token" name="token" pattern="[A-Za-z0-9]{1,64}" required autocomplete="off" />
      <button class="secondary" type="submit" disabled={!ready || !originMatches}>Read PayPal status only</button>
    </form>
  </section>
</Layout>
