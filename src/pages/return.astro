---
import Layout from '../components/Layout.astro';
import Status from '../components/Status.astro';
import { runtime } from '../lib/runtime';
import { applicationError } from '../lib/errors';
import { finishApprovedOrder, orderToken } from '../lib/flow';
import type { OrderStatus } from '../lib/types';
let token = '';
let result: OrderStatus | undefined;
let error;
try {
  token = orderToken(Astro.url.searchParams.get('token'));
  const { config, paypal } = runtime();
  result = await finishApprovedOrder(token, paypal, config);
} catch (failure) { error = applicationError(failure); Astro.response.status = error.httpStatus; }
---
<Layout title="PayPal return"><Status result={result} error={error} token={token} captureAllowed={true} /></Layout>
