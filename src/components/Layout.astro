---
import '../styles/w1.css';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SayPay intent drafts and a separate manual PayPal sandbox order flow." />
    <title>{title} — SayPay</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header><a href="/parse">SayPay <span>Demo</span></a><span>PayPal sandbox · test money only</span></header>
    <main id="main"><slot /></main>
    <footer>Review the stored draft before confirming. Buyer approval takes place on PayPal. Sandbox test money only.</footer>
  </body>
</html>
